{
  "expo": {
    "name": "Bugsha partner",
    "slug": "bugsha-partner",
    "scheme": "bugsha-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.bugsha.partner",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Attach a photo to a report or a document."
      }
    },
    "android": {
      "package": "org.bugsha.partner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B21B6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used once to place your store pin."
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "6687e2c4-6e4a-4055-aa7f-0b79d2efa048"
      },
      "router": {
        "origin": false
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B21B6"
    },
    "updates": {
      "url": "https://u.expo.dev/6687e2c4-6e4a-4055-aa7f-0b79d2efa048"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "bugsha"
  }
}
