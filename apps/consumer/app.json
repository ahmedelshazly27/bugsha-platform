{
  "expo": {
    "name": "Bugsha consumer",
    "slug": "bugsha-consumer",
    "scheme": "bugsha",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.bugsha.consumer",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.bugsha.consumer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B21B6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "91ae8029-a348-4c84-8837-68c2c7726d0a"
      },
      "router": {
        "origin": false
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#5B21B6"
    },
    "updates": {
      "url": "https://u.expo.dev/91ae8029-a348-4c84-8837-68c2c7726d0a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "bugsha"
  }
}
